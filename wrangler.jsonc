{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ikasoft",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "main": "_worker.js",
  "assets": {
    "directory": ".",
    "binding": "STATIC_ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "ikasoft.cn/*",
      "custom_domain": true
    },
    {
      "pattern": "www.ikasoft.cn/*",
      "custom_domain": true
    }
  ]
}
